SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///./shopkart.db
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# Optional — leave empty to hide OAuth buttons
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Ravi AI Assistant — factory picks the provider
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.3
# Seconds to wait between Gemini/OpenAI/etc. calls (helps free-tier RPM). 0 disables.
LLM_CALL_GAP_SECONDS=6
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-0
GROK_API_KEY=
GROK_MODEL=grok-3-mini
GROK_BASE_URL=https://api.x.ai/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
